# Copia a .env y rellena los valores reales.
# cp .env.example .env
#
# Instancia PostgreSQL compartida en projectes_network — usada por varios
# proyectos (ver ../INFRAESTRUCTURA.md). Estas credenciales son las del
# superusuario; cada proyecto debe crear su propio rol/base de datos dentro
# de esta instancia en lugar de usar este usuario directamente.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres
